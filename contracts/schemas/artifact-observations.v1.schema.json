{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/contracts/artifact-observations.v1.schema.json",
  "title": "Flow host artifact observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_set_id",
    "digest_algorithm",
    "directory_manifest_profile",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "flow.artifact-observations/v1" },
    "binding_set_id": {
      "type": "string",
      "pattern": "^bindings:[a-z0-9][a-z0-9._-]*$"
    },
    "digest_algorithm": { "const": "sha256" },
    "directory_manifest_profile": { "const": "flow.directory-manifest/v1" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "port",
          "media_type",
          "kind",
          "locator",
          "digest",
          "size_bytes",
          "manifest"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^artifact:[a-z0-9][a-z0-9._-]*$"
          },
          "port": {
            "type": "string",
            "pattern": "^port:[a-z0-9][a-z0-9._-]*$"
          },
          "media_type": { "type": "string", "pattern": "^[^/\\s*]+/[^/\\s*]+$" },
          "kind": { "enum": ["file", "directory"] },
          "locator": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "manifest": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator", "kind", "digest", "size_bytes"],
              "properties": {
                "locator": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["file", "directory"] },
                "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                }
              }
            }
          }
        }
      }
    }
  }
}
