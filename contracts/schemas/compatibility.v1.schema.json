{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/contracts/compatibility.v1.schema.json",
  "title": "Flow compatibility decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "orchestrator_version", "provider", "capability_id", "required_contracts", "result", "reasons", "evidence"],
  "properties": {
    "schema_version": { "const": "flow.compatibility/v1" },
    "orchestrator_version": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "version", "interface_kind", "interface_version"],
      "properties": {
        "owner": { "enum": ["aniflow", "optiflow", "renderflow"] },
        "version": { "type": "string", "minLength": 1 },
        "interface_kind": { "enum": ["library", "cli"] },
        "interface_version": { "type": "string", "minLength": 1 }
      }
    },
    "capability_id": { "type": "string", "minLength": 1 },
    "required_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^flow\\.[a-z-]+/v[1-9][0-9]*$" }
    },
    "result": { "enum": ["compatible", "incompatible", "unknown"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["version-probe", "contract-test", "fixture", "manual-review"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
