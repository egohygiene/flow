{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/flow-release-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "version",
    "source_revision",
    "target",
    "primary_binary",
    "compiled_descriptor",
    "provider_cohort",
    "library_source",
    "assets",
    "native_build",
    "retained_target_objectives",
    "registry_channel",
    "qualification",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.release-manifest/v1"
    },
    "repository": {
      "const": "egohygiene/flow"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "enum": [
        "x86_64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin"
      ]
    },
    "primary_binary": {
      "type": "string",
      "minLength": 1
    },
    "compiled_descriptor": {
      "const": "flow-release-contract-v1.json"
    },
    "provider_cohort": {
      "const": "provider-cohort.json"
    },
    "library_source": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "byte_count",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "native_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_target",
        "rustc",
        "isolated_builds"
      ],
      "properties": {
        "host_target": {
          "type": "string",
          "minLength": 1
        },
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "isolated_builds": {
          "const": 2
        }
      }
    },
    "retained_target_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registry_channel": {
      "const": "unavailable"
    },
    "qualification": {
      "const": "not_established_by_preparation"
    },
    "publication": {
      "const": "not_performed"
    }
  }
}
