{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.publishing-readiness-request/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_manifest", "timeout_ms"],
  "properties": {
    "schema_version": {"const": "flow.publishing-readiness-request/v1"},
    "package_manifest": {"$ref": "delivery-request-v1.schema.json#/properties/project_record"},
    "audio_summary": {"oneOf": [{"type": "null"}, {"$ref": "delivery-request-v1.schema.json#/properties/project_record"}]},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
  }
}
