{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.ai-local-setup/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "deployment_id",
    "endpoint",
    "service_egress_disabled_declared",
    "runtime_license",
    "model_license",
    "quantization",
    "maximum_observation_bytes",
    "deadline_ms",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.ai-local-setup/v1"
    },
    "profile": {
      "$comment": "Proposed; authored/unvalidated. Runtime-native, hardware and offline qualification remain unknown; matching bytes grants no invocation authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "provider_id",
        "model_id",
        "runtime_revision",
        "model_revision",
        "mode",
        "template_sha256",
        "output_schema_sha256",
        "modality",
        "structured_output",
        "budgets"
      ],
      "properties": {
        "schema_version": {
          "const": "flow.ai-preparation-profile/v1"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,96}$"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:+-][A-Za-z0-9._:+/-]*$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:+-][A-Za-z0-9._:+/-]*$"
        },
        "runtime_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:+-][A-Za-z0-9._:+/-]*$"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:+-][A-Za-z0-9._:+/-]*$"
        },
        "mode": {
          "enum": [
            "disabled",
            "local_only",
            "remote"
          ]
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modality": {
          "enum": [
            "text",
            "image",
            "audio",
            "video"
          ]
        },
        "structured_output": {
          "type": "boolean"
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_bytes",
            "output_bytes",
            "context_tokens",
            "output_tokens",
            "deadline_ms",
            "attempts",
            "concurrency",
            "memory_mib",
            "working_bytes",
            "hard_cost_microunits"
          ],
          "properties": {
            "input_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "context_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            },
            "deadline_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "attempts": {
              "const": 1
            },
            "concurrency": {
              "const": 1
            },
            "memory_mib": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "working_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 137438953472
            },
            "hard_cost_microunits": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "endpoint": {
      "type": "string",
      "maxLength": 64
    },
    "service_egress_disabled_declared": {
      "type": "boolean"
    },
    "runtime_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quantization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "maximum_observation_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 137438953472
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "kind",
          "path",
          "expected_sha256"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "kind": {
            "enum": [
              "runtime_executable",
              "model_weights",
              "model_configuration"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          },
          "expected_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          }
        }
      }
    }
  }
}
