{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/release-evidence-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owners",
    "host_identity",
    "maximum_age_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.release-evidence-policy/v1"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "repository",
          "signer_workflow",
          "signer_revision",
          "source_revision",
          "source_ref"
        ],
        "properties": {
          "tool": {
            "enum": [
              "flow",
              "aniflow",
              "renderflow",
              "optiflow"
            ]
          },
          "repository": {
            "enum": [
              "egohygiene/flow",
              "egohygiene/aniflow",
              "egohygiene/renderflow",
              "egohygiene/optiflow"
            ]
          },
          "signer_workflow": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "signer_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "minItems": 1,
      "maxItems": 4
    },
    "host_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "value"
              ],
              "properties": {
                "encoding": {
                  "const": "utf8"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "base64"
              ],
              "properties": {
                "encoding": {
                  "const": "unix_bytes"
                },
                "base64": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "maximum_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "github_credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "value"
              ],
              "properties": {
                "encoding": {
                  "const": "utf8"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "base64"
              ],
              "properties": {
                "encoding": {
                  "const": "unix_bytes"
                },
                "base64": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    }
  }
}
