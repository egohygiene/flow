{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/manual-srt-pilot-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "manual_srt",
    "audio_source",
    "video",
    "timed_text",
    "audio",
    "run_directory"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.manual-srt-pilot-request/v1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "language"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "manual_srt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "value"
              ],
              "properties": {
                "encoding": {
                  "const": "utf8"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "base64"
              ],
              "properties": {
                "encoding": {
                  "const": "unix_bytes"
                },
                "base64": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736
        }
      }
    },
    "audio_source": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byte_count"
          ],
          "properties": {
            "path": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "value"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "utf8"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "base64"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "unix_bytes"
                    },
                    "base64": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 68719476736
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "video": {
      "$ref": "flow-native-request-v1.schema.json"
    },
    "timed_text": {
      "$ref": "flow-native-request-v1.schema.json"
    },
    "audio": {
      "anyOf": [
        {
          "$ref": "flow-native-request-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_directory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
