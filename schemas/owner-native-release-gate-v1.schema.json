{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/owner-native-release-gate-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_subject_sha256",
    "artifact_sha256",
    "target",
    "host_identity_sha256",
    "completed_at_unix",
    "plan_sha256",
    "acceptance_sha256",
    "evidence_kind",
    "accepted_checks",
    "failed_checks",
    "missing_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.owner-native-release-gate/v1"
    },
    "row_subject_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "host_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completed_at_unix": {
      "type": "integer",
      "minimum": 0
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_kind": {
      "const": "real_native_release_gate"
    },
    "accepted_checks": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "enum": [
          "native_build",
          "positive_contract_probe",
          "clean_install",
          "positive_smoke",
          "domain_acceptance"
        ]
      }
    },
    "failed_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 0
    },
    "missing_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 0
    }
  }
}
