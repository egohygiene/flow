{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/flow/schemas/diagnostics-preview-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flow.diagnostics-preview/v1"
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "build",
          "platform",
          "contracts"
        ]
      },
      "minItems": 1,
      "maxItems": 3
    },
    "member_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "archive_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "files_written": {
      "const": false
    },
    "network_contacted": {
      "const": false
    },
    "domain_evidence": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "categories",
    "member_count",
    "archive_bytes",
    "exclusions",
    "files_written",
    "network_contacted",
    "domain_evidence"
  ],
  "additionalProperties": false
}
