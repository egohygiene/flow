{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/flow/schemas/release-coverage-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flow.release-coverage/v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "matrix": {
      "$ref": "flow-release-matrix-v1.schema.json"
    },
    "required": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expected": {
            "type": "object",
            "properties": {
              "tool": {
                "enum": [
                  "flow",
                  "aniflow",
                  "optiflow",
                  "renderflow"
                ]
              },
              "interface": {
                "enum": [
                  "standalone_cli",
                  "rust_library",
                  "flow_route"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "profile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              "row_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "tool",
              "interface",
              "target",
              "profile"
            ],
            "additionalProperties": false
          },
          "matching_rows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "minItems": 0,
            "maxItems": 4096
          },
          "state": {
            "enum": [
              "missing",
              "ambiguous",
              "blocked",
              "unverified",
              "green"
            ]
          }
        },
        "required": [
          "expected",
          "matching_rows",
          "state"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 512
    },
    "green": {
      "type": "integer",
      "minimum": 0,
      "maximum": 512
    },
    "missing": {
      "type": "integer",
      "minimum": 0,
      "maximum": 512
    },
    "ambiguous": {
      "type": "integer",
      "minimum": 0,
      "maximum": 512
    },
    "blocked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 512
    },
    "unverified": {
      "type": "integer",
      "minimum": 0,
      "maximum": 512
    },
    "unrequested_rows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "all_requested_green": {
      "type": "boolean"
    },
    "whole_suite_qualified": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "request_sha256",
    "matrix",
    "required",
    "green",
    "missing",
    "ambiguous",
    "blocked",
    "unverified",
    "unrequested_rows",
    "all_requested_green",
    "whole_suite_qualified"
  ],
  "additionalProperties": false
}
