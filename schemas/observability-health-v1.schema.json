{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/flow/schemas/observability-health-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flow.observability-health/v1"
    },
    "scope": {
      "const": "flow_owned_operational_signals"
    },
    "instrumentation": {
      "const": "not_implemented"
    },
    "exporters": {
      "const": "not_implemented"
    },
    "collector_reachability": {
      "const": "not_observed"
    },
    "queue_drops": {
      "const": null
    },
    "shutdown_flush": {
      "const": "not_observed"
    },
    "network_contacted": {
      "const": false
    },
    "domain_evidence": {
      "const": false
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "instrumentation",
    "exporters",
    "collector_reachability",
    "queue_drops",
    "shutdown_flush",
    "network_contacted",
    "domain_evidence",
    "next_action"
  ],
  "additionalProperties": false
}
