{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.ai-local-preparation/v1",
  "$comment": "Proposed; authored/unvalidated. Runtime-native, hardware and offline qualification remain unknown; matching bytes grants no invocation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "profile_sha256",
    "endpoint",
    "service_egress_disabled_declared",
    "runtime_license",
    "model_license",
    "quantization",
    "maximum_observation_bytes",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.ai-local-preparation/v1"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,96}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "service_egress_disabled_declared": {
      "type": "boolean"
    },
    "runtime_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quantization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "maximum_observation_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 137438953472
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "kind",
          "path",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,96}$"
          },
          "kind": {
            "enum": [
              "runtime_executable",
              "model_weights",
              "model_configuration"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8589934592
          }
        }
      }
    }
  }
}
