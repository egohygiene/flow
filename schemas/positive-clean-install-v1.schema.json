{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/positive-clean-install-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_subject_sha256",
    "installed_executable_sha256",
    "contracts",
    "empty_destination_observed",
    "positive_native_plan_sha256",
    "positive_acceptance_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.positive-clean-install/v1"
    },
    "row_subject_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installed_executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "sha256"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    },
    "empty_destination_observed": {
      "const": true
    },
    "positive_native_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positive_acceptance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
