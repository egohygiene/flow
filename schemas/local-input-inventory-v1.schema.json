{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.local-input-inventory/v1",
  "$comment": "Authored/unvalidated. Local file observations are not native media acceptance, source freezing or provider runtime budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_sha256",
    "request_sha256",
    "files",
    "directories",
    "excluded_subtrees",
    "entries_seen",
    "total_bytes",
    "content_type",
    "domain_acceptance",
    "execution_input_freeze"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.local-input-inventory/v1"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "path",
          "filesystem_id",
          "file_id",
          "byte_count",
          "sha256"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "path": {
            "$ref": "optiflow-read-only-receipt-v1.schema.json#/$defs/native_path"
          },
          "filesystem_id": {
            "type": "integer",
            "minimum": 0
          },
          "file_id": {
            "type": "integer",
            "minimum": 0
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "directories": {
      "type": "array",
      "maxItems": 4097,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "filesystem_id",
          "file_id"
        ],
        "properties": {
          "path": {
            "$ref": "optiflow-read-only-receipt-v1.schema.json#/$defs/native_path"
          },
          "filesystem_id": {
            "type": "integer",
            "minimum": 0
          },
          "file_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "excluded_subtrees": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "optiflow-read-only-receipt-v1.schema.json#/$defs/native_path"
      }
    },
    "entries_seen": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967296
    },
    "content_type": {
      "const": "unclassified_octets; extension_is_not_media_proof"
    },
    "domain_acceptance": {
      "const": false
    },
    "execution_input_freeze": {
      "const": false
    }
  }
}
