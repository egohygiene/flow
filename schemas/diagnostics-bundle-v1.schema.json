{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/flow/schemas/diagnostics-bundle-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flow.diagnostics-bundle/v1"
    },
    "redaction_policy": {
      "const": "generated_metadata_only.v1"
    },
    "domain_evidence": {
      "const": false
    },
    "members": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "const": "build.json"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "payload": {
                "type": "object",
                "properties": {
                  "category": {
                    "const": "build"
                  },
                  "tool": {
                    "const": "flow"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                },
                "required": [
                  "category",
                  "tool",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "sha256",
              "byte_count",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "const": "platform.json"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "payload": {
                "type": "object",
                "properties": {
                  "category": {
                    "const": "platform"
                  },
                  "compiled_os": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  },
                  "compiled_arch": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                  }
                },
                "required": [
                  "category",
                  "compiled_os",
                  "compiled_arch"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "sha256",
              "byte_count",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "const": "contracts.json"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "payload": {
                "type": "object",
                "properties": {
                  "category": {
                    "const": "contracts"
                  },
                  "source_contract_ids": {
                    "const": [
                      "flow.command-result/v1",
                      "flow.command-request/v1",
                      "flow.release-matrix/v1"
                    ]
                  }
                },
                "required": [
                  "category",
                  "source_contract_ids"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "sha256",
              "byte_count",
              "payload"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "required": [
    "schema_version",
    "redaction_policy",
    "domain_evidence",
    "members"
  ],
  "additionalProperties": false
}
