{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.local-input-plan/v1",
  "$comment": "Authored/unvalidated. Local file observations are not native media acceptance, source freezing or provider runtime budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory",
    "availability",
    "reason",
    "command_plan",
    "inspection_limits_apply_to_native_execution"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.local-input-plan/v1"
    },
    "inventory": {
      "$ref": "local-input-inventory-v1.schema.json"
    },
    "availability": {
      "enum": [
        "inspection_only",
        "scope_plan_only",
        "unavailable"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 512
    },
    "command_plan": {
      "anyOf": [
        {
          "$ref": "command-plan-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "inspection_limits_apply_to_native_execution": {
      "const": false
    }
  }
}
