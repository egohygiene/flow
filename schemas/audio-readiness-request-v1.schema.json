{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.audio-readiness-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_manifest",
    "selections",
    "timeout_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.audio-readiness-request/v1"
    },
    "package_manifest": {
      "$ref": "delivery-request-v1.schema.json#/properties/project_record"
    },
    "selections": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload_id",
          "destination",
          "choice"
        ],
        "properties": {
          "payload_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "destination": {
            "enum": [
              "archive",
              "soundcloud",
              "distrokid",
              "tiktok"
            ]
          },
          "choice": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "plan",
                  "authority"
                ],
                "properties": {
                  "kind": {
                    "const": "check"
                  },
                  "plan": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256",
                      "byte_count"
                    ],
                    "properties": {
                      "path": {
                        "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "byte_count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      }
                    }
                  },
                  "authority": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "approval"
                        ],
                        "properties": {
                          "kind": {
                            "const": "source_candidate"
                          },
                          "approval": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "sha256",
                              "byte_count"
                            ],
                            "properties": {
                              "path": {
                                "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "byte_count": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 1048576
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "approval"
                        ],
                        "properties": {
                          "kind": {
                            "const": "released"
                          },
                          "approval": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "sha256",
                              "byte_count"
                            ],
                            "properties": {
                              "path": {
                                "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "byte_count": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 1048576
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "const": "keep_archive_master"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            ]
          }
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    }
  },
  "$comment": "Authored/unvalidated source contract. Native owner binding, current final-byte QC, approval, complete destination coverage and output scope remain runtime checks. No universal loudness, qualification or upload authority is asserted."
}
