{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/flow/schemas/publishing-project-selection-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flow.publishing-project-selection/v1"
    },
    "metadata": {
      "$ref": "publishing-project-v1.schema.json#/properties/metadata"
    },
    "video": {
      "$ref": "publishing-project-v1.schema.json#/properties/video"
    },
    "manual_srt": {
      "$ref": "publishing-project-v1.schema.json#/properties/manual_srt"
    },
    "workspace": {
