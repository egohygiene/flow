{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/flow-native-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort",
    "cohort_sha256",
    "row_id",
    "provider_executable",
    "release_descriptor",
    "inputs",
    "configuration",
    "run_directory",
    "tool_directories",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.native-request/v1"
    },
    "cohort": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "cohort_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "row_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_executable": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "release_descriptor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "value"
            ],
            "properties": {
              "encoding": {
                "const": "utf8"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "base64"
            ],
            "properties": {
              "encoding": {
                "const": "unix_bytes"
              },
              "base64": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "configuration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "run_directory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "tool_directories": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "value"
            ],
            "properties": {
              "encoding": {
                "const": "utf8"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "base64"
            ],
            "properties": {
              "encoding": {
                "const": "unix_bytes"
              },
              "base64": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "max_input_bytes",
        "max_output_bytes",
        "max_total_output_bytes",
        "max_artifacts"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736
        },
        "max_total_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "max_artifacts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "value"
              ],
              "properties": {
                "encoding": {
                  "const": "utf8"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "base64"
              ],
              "properties": {
                "encoding": {
                  "const": "unix_bytes"
                },
                "base64": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    }
  }
}
