{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/flow/schemas/diagnostics-request-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flow.diagnostics-request/v1"
    },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "build",
          "platform",
          "contracts"
