{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/delivery-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_record",
    "handoff",
    "payloads",
    "metadata",
    "reviews",
    "evidence_attachments",
    "output_directory",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.delivery-request/v1"
    },
    "project_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "source",
          "file_name",
          "destinations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,96}$"
          },
          "role": {
            "enum": [
              "clean_master",
              "video_delivery",
              "original_audio",
              "audio_derivative",
              "lyrics",
              "artwork",
              "supporting_document"
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "stage",
                  "artifact_id"
                ],
                "properties": {
                  "kind": {
                    "const": "native"
                  },
                  "stage": {
                    "enum": [
                      "video",
                      "timed_text",
                      "audio"
                    ]
                  },
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "original_audio"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "manual_srt"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "file"
                ],
                "properties": {
                  "kind": {
                    "const": "external"
                  },
                  "file": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256",
                      "byte_count"
                    ],
                    "properties": {
                      "path": {
                        "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "byte_count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 68719476736
                      }
                    }
                  }
                }
              }
            ]
          },
          "file_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "destinations": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "enum": [
                "archive",
                "soundcloud",
                "distrokid",
                "tiktok"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creators",
        "description",
        "tags",
        "destination_fields"
      ],
      "properties": {
        "creators": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32768
        },
        "tags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "destination_fields": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination",
              "fields"
            ],
            "properties": {
              "destination": {
                "enum": [
                  "archive",
                  "soundcloud",
                  "distrokid",
                  "tiktok"
                ]
              },
              "fields": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            }
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "path": {
            "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        }
      }
    },
    "evidence_attachments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "path": {
            "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        }
      }
    },
    "output_directory": {
      "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "maximum_payload_bytes",
        "maximum_total_bytes"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maximum_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736
        },
        "maximum_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        }
      }
    }
  }
}
