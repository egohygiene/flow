{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/publisher-artifact-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "cohort_sha256",
    "row_subject_sha256",
    "asset_kind",
    "version",
    "source_revision",
    "target",
    "archive",
    "publication",
    "executable_member",
    "contracts",
    "members"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.publisher-artifact-report/v1"
    },
    "tool": {
      "enum": [
        "flow",
        "aniflow",
        "renderflow",
        "optiflow"
      ]
    },
    "cohort_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "row_subject_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_kind": {
      "enum": [
        "tar_gz",
        "raw_binary"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byte_count",
        "name"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_url",
        "release_id",
        "asset_id"
      ],
      "properties": {
        "release_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "asset_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "executable_member": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "contracts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "member",
          "sha256",
          "byte_count",
          "publication"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "member": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "publication": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "release_url",
                  "asset_id"
                ],
                "properties": {
                  "release_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "asset_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "byte_count"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          }
        }
      }
    }
  }
}
