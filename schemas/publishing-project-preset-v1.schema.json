{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/flow/schemas/publishing-project-preset-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "flow.publishing-project-preset/v1"
    },
    "preset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "installation": {
      "$ref": "publishing-project-v1.schema.json#/properties/installation"
    },
    "video_configuration": {
      "$ref": "publishing-project-v1.schema.json#/properties/video_configuration"
    },
    "destinations": {
      "$ref": "publishing-project-v1.schema.json#/properties/destinations"
    },
    "tool_directories": {
      "$ref": "publishing-project-v1.schema.json#/properties/tool_directories"
    },
    "limits": {
      "$ref": "publishing-project-v1.schema.json#/properties/limits"
    },
    "rows": {
      "$ref": "publishing-project-v1.schema.json#/properties/rows"
    },
    "preparation": {
      "anyOf": [
        {
          "$ref": "publishing-project-v1.schema.json#/properties/preparation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "preset_id",
    "installation",
    "video_configuration",
    "destinations",
    "tool_directories",
    "limits",
    "rows"
  ],
  "additionalProperties": false
}
