{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.command-completion/v1",
  "$comment": "Authored/unvalidated source contract. Exact pins, current scope, authority and native receipts are checked in Rust; qualification remains deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_sha256",
    "approval_sha256",
    "receipt_sha256",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.command-completion/v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "$ref": "optiflow-read-only-receipt-v1.schema.json#/$defs/native_path"
    }
  }
}
