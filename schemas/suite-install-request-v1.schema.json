{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/suite-install-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort",
    "target",
    "install_directory",
    "tools",
    "timeout_ms",
    "maximum_total_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.suite-install-request/v1"
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "value"
              ],
              "properties": {
                "encoding": {
                  "const": "utf8"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "base64"
              ],
              "properties": {
                "encoding": {
                  "const": "unix_bytes"
                },
                "base64": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        }
      }
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "install_directory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "row_id",
          "executable",
          "contracts",
          "extras"
        ],
        "properties": {
          "tool": {
            "enum": [
              "flow",
              "aniflow",
              "optiflow",
              "renderflow"
            ]
          },
          "row_id": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "byte_count"
            ],
            "properties": {
              "path": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "value"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "utf8"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "encoding",
                      "base64"
                    ],
                    "properties": {
                      "encoding": {
                        "const": "unix_bytes"
                      },
                      "base64": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 536870912
              }
            }
          },
          "contracts": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identifier",
                "file"
              ],
              "properties": {
                "identifier": {
                  "type": "string",
                  "minLength": 1
                },
                "file": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "byte_count"
                  ],
                  "properties": {
                    "path": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "encoding",
                            "value"
                          ],
                          "properties": {
                            "encoding": {
                              "const": "utf8"
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "encoding",
                            "base64"
                          ],
                          "properties": {
                            "encoding": {
                              "const": "unix_bytes"
                            },
                            "base64": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "byte_count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 536870912
                    }
                  }
                }
              }
            }
          },
          "extras": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "file"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "file": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256",
                    "byte_count"
                  ],
                  "properties": {
                    "path": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "encoding",
                            "value"
                          ],
                          "properties": {
                            "encoding": {
                              "const": "utf8"
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "encoding",
                            "base64"
                          ],
                          "properties": {
                            "encoding": {
                              "const": "unix_bytes"
                            },
                            "base64": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      ]
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "byte_count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 536870912
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "maximum_total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    }
  }
}
