{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/publisher-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owners",
    "maximum_age_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.publisher-policy/v1"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "repository",
          "signer_workflow",
          "signer_revision",
          "source_revision",
          "source_ref"
        ],
        "properties": {
          "tool": {
            "enum": [
              "flow",
              "aniflow",
              "renderflow",
              "optiflow"
            ]
          },
          "repository": {
            "enum": [
              "egohygiene/flow",
              "egohygiene/aniflow",
              "egohygiene/renderflow",
              "egohygiene/optiflow"
            ]
          },
          "signer_workflow": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "signer_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "maximum_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "github_credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    }
  }
}
