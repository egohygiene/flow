{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/flow/schemas/publisher-verification-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort",
    "selections",
    "timeout_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "flow.publisher-verification-request/v1"
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "path": {
          "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "report",
          "sigstore_bundle",
          "archive"
        ],
        "properties": {
          "row_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "report": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "byte_count"
            ],
            "properties": {
              "path": {
                "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              }
            }
          },
          "sigstore_bundle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "byte_count"
            ],
            "properties": {
              "path": {
                "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216
              }
            }
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "byte_count"
            ],
            "properties": {
              "path": {
                "$ref": "flow-native-request-v1.schema.json#/properties/cohort"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 536870912
              }
            }
          }
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    }
  }
}
