{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"flow.workflow-guide-catalog/v1",
 "type":"object","additionalProperties":false,
 "required":["schema_version","claim_scope","runtime_qualified","observed_executions","workflows"],
 "properties":{
  "schema_version":{"const":"flow.workflow-guide-catalog/v1"},"claim_scope":{"const":"source_guides_only"},"runtime_qualified":{"const":false},"observed_executions":{"const":0},
  "workflows":{"type":"array","minItems":1,"maxItems":64,"items":{
   "type":"object","additionalProperties":false,
   "required":["id","title","description","input_output","availability","source","issue","pull_request","steps","prerequisites","remaining"],
   "properties":{
    "id":{"type":"string","maxLength":128,"pattern":"^workflow:[a-z0-9_-]+$"},"title":{"type":"string","maxLength":256},"description":{"type":"string","maxLength":2048},"input_output":{"type":"string","maxLength":2048},
    "availability":{"enum":["draft_source","merged_source"]},
    "source":{"type":"object","additionalProperties":false,"required":["repository","revision","path"],"properties":{"repository":{"enum":["flow","aniflow","optiflow","renderflow"]},"revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"path":{"type":"string","maxLength":512,"minLength":1}}},
    "issue":{"type":"string","pattern":"^https://github\\.com/egohygiene/(flow|aniflow|optiflow|renderflow)/issues/[1-9][0-9]*$"},
    "pull_request":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^https://github\\.com/egohygiene/(flow|aniflow|optiflow|renderflow)/pull/[1-9][0-9]*$"}]},
    "steps":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["owner","action"],"properties":{"owner":{"enum":["flow","aniflow","optiflow","renderflow","operator"]},"action":{"type":"string","maxLength":2048}}}},
    "prerequisites":{"$ref":"#/$defs/strings"},"remaining":{"$ref":"#/$defs/strings"}
   }
  }}
 },"$defs":{"strings":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","maxLength":2048}}}
}
